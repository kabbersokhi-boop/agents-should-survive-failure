# Safe local defaults. Never put credentials in this file.
APP_ENV=development
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
POSTGRES_DB=agents
POSTGRES_USER=agents
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://agents:local-development-only@localhost:5432/agents
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
DEPENDENCY_TIMEOUT_SECONDS=3
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agents-control-plane-api
LOG_LEVEL=INFO
